---
/**
 * A SAVED ROOM OF THE DOJO, with its own address (decision 0010): one page for each recipe in
 * `games/dojo/recipes/`. It is the same Dojo, born with that recipe. Adding a room is adding a
 * file: the page comes by itself. Like the console, rooms are in English (decision 0011).
 */
import { ROOMS } from '@manifold/dojo/rooms';
import DojoPage from '../../../components/DojoPage.astro';

export function getStaticPaths() {
  return Object.entries(ROOMS).map(([room, { title }]) => ({ params: { room }, props: { title } }));
}
const { room } = Astro.params;
const { title } = Astro.props;
---

<DojoPage room={room} title={title} />
