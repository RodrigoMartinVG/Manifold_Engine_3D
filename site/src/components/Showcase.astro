---
/**
 * THE HOME PAGE'S SHOWCASE: a bronze frame with a live 3D scene (src/showcase/showcase.ts), two
 * gears that really mesh, and a plate that says what is seen.
 *
 * Three.js is fetched AFTER the page is drawn (with a dynamic `import()`, which Vite splits into
 * its own file): the home page shows up right away, and the showcase lights up a moment later.
 * Without WebGL, the frame stays with its background, and nothing breaks.
 *
 * The gears (scripts/draw.mjs) have the same module: 20 and 12 teeth, pitch radii 40 and 24,
 * centers 64 units apart. So they do not jam, they turn in opposite directions with periods in a
 * 20 : 12 ratio (40 s and 24 s), and start with a tooth facing a gap.
 *
 * (The plate's text is the site's, in Spanish.)
 */
import gear20 from '../assets/drawings/gear-20.svg';
import gear12 from '../assets/drawings/gear-12.svg';
---

<figure class="showcase not-content" data-state="loading">
  <img class="gear gear-big" src={gear20.src} alt="" aria-hidden="true" />
  <img class="gear gear-small" src={gear12.src} alt="" aria-hidden="true" />
  <div class="showcase-frame">
    <div class="showcase-window" role="img" aria-label="Tres cuerpos en órbita sobre un pozo de potencial, en 3D"></div>
  </div>
  <figcaption class="showcase-plate">
    <span>Pozo de potencial <i>Φ = −GM / r</i></span>
    <span class="showcase-step">paso <b>0</b></span>
  </figcaption>
</figure>

<style>
  .showcase {
    /* The gears' unit: 1 drawing unit = --u pixels. */
    --u: 1.1px;
    position: relative;
    margin: 0;
    padding-top: 2.5rem; /* room for the gears that peek out at the top */
  }

  /* ---------- the gears ---------- */
  .gear {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  /* The big one's center: 2.5rem + 6px from the top, and inside the right edge (so it does not
     stick out of the page). The small one, 64 units from the big one in the 200° direction: to the
     left and a little higher. */
  .gear-big {
    width: calc(92 * var(--u));
    top: calc(2.5rem + 6px - 46 * var(--u));
    right: 0.5rem;
    rotate: 200deg; /* a tooth points at the small one */
    animation-name: turn-big;
    animation-duration: 40s;
  }
  .gear-small {
    width: calc(60 * var(--u));
    top: calc(2.5rem + 6px - 21.89 * var(--u) - 30 * var(--u));
    right: calc(0.5rem + 46 * var(--u) + 60.14 * var(--u) - 30 * var(--u));
    rotate: 35deg; /* 200° + 180° + half a tooth (15°): a gap faces the big one */
    animation-name: turn-small;
    animation-duration: 24s;
  }
  @keyframes turn-big {
    to {
      rotate: 560deg;
    }
  }
  @keyframes turn-small {
    to {
      rotate: -325deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gear {
      animation: none;
    }
  }

  /* ---------- the frame and the window ---------- */
  .showcase-frame {
    position: relative;
    z-index: 1;
    padding: 12px;
    border-radius: 14px;
    background: var(--mg-metal);
    box-shadow:
      0 0 0 1px #1f1408,
      var(--mg-bevel),
      0 34px 60px -30px rgb(0 0 0 / 0.95);
  }
  .showcase-frame::before {
    content: '';
    position: absolute;
    inset: 3px;
    pointer-events: none;
    background:
      var(--mg-rivet) 0 0 / 8px 8px no-repeat,
      var(--mg-rivet) 100% 0 / 8px 8px no-repeat,
      var(--mg-rivet) 0 100% / 8px 8px no-repeat,
      var(--mg-rivet) 100% 100% / 8px 8px no-repeat;
  }
  .showcase-window {
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: 6px;
    overflow: hidden;
    /* Always dark, also in light mode: it is a showcase. */
    background: radial-gradient(ellipse 70% 70% at 50% 58%, #133530, #0a1513 58%, #060808);
    box-shadow:
      inset 0 0 0 1px #000,
      inset 0 0 34px rgb(0 0 0 / 0.9);
    touch-action: pan-y;
  }
  /* The glass's reflection. */
  .showcase-window::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(155deg, rgb(255 255 255 / 0.07), transparent 32%);
  }
  .showcase-window :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .showcase[data-state='ready'] .showcase-window :global(canvas) {
    opacity: 1;
  }

  /* ---------- the plate ---------- */
  .showcase-plate {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.2rem 1.4rem;
    width: fit-content;
    max-width: calc(100% - 3rem);
    margin: -0.95rem auto 0;
    padding: 0.3rem 1.6rem 0.35rem;
    border-radius: 4px;
    background:
      var(--mg-rivet) 0.45rem 50% / 8px 8px no-repeat,
      var(--mg-rivet) calc(100% - 0.45rem) 50% / 8px 8px no-repeat,
      var(--mg-metal);
    box-shadow:
      0 0 0 1px #24170a,
      var(--mg-bevel),
      0 8px 16px -8px rgb(0 0 0 / 0.8);
    color: var(--mg-text-on-bronze);
    /* Engraved letters: the shadow on top sinks them into the metal. */
    text-shadow: var(--mg-engraved);
    font-family: var(--mg-font-title);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.5;
  }
  .showcase-plate span {
    white-space: nowrap;
  }
  .showcase-plate i {
    margin-inline-start: 0.35em;
    font-family: var(--mg-font-book);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }
  .showcase-step b {
    font-family: var(--sl-font-system-mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  @media (max-width: 40rem) {
    .showcase {
      --u: 0.8px;
      padding-top: 1.8rem;
    }
    .gear-big {
      top: calc(1.8rem + 6px - 46 * var(--u));
    }
    .gear-small {
      top: calc(1.8rem + 6px - 21.89 * var(--u) - 30 * var(--u));
    }
    .showcase-frame {
      padding: 8px;
    }
  }
</style>

<script>
  const figure = document.querySelector<HTMLElement>('.showcase');
  const view = figure?.querySelector<HTMLElement>('.showcase-window');
  const counter = figure?.querySelector<HTMLElement>('.showcase-step b');

  async function light(figure: HTMLElement, view: HTMLElement) {
    try {
      const { startShowcase } = await import('../showcase/showcase');
      startShowcase(view, {
        onStep: (step) => {
          if (counter) counter.textContent = step.toLocaleString('es');
        },
      });
      figure.dataset.state = 'ready';
    } catch (e) {
      // Without WebGL (or without network): the empty frame stays, which also looks fine.
      figure.dataset.state = 'no-3d';
      console.warn('The showcase could not start:', e);
    }
  }

  if (figure && view) {
    // First let the page be drawn; then, Three.js.
    if ('requestIdleCallback' in window) requestIdleCallback(() => void light(figure, view), { timeout: 1200 });
    else setTimeout(() => void light(figure, view), 300);
  }
</script>
