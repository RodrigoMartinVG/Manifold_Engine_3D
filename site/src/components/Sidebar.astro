---
/**
 * Starlight's sidebar (it replaces "Sidebar" in astro.config.mjs), with a button at the top to hide
 * it. It does the same as the header's button (ThemeSelect.astro, which has the code), but it is
 * where one looks for it. It does not show up on the phone: there the sidebar is the menu.
 */
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<button type="button" class="mg-panel mg-hide mg-hide-sidebar" data-panel="sidebar">‹ Ocultar el índice</button>
<Default />
