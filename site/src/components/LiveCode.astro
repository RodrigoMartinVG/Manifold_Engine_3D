---
/**
 * <LiveCode lesson="stage-0/01-first-cube" />: an example that is edited and run in the page
 * (decision 0007).
 *
 * A lesson's files live in `src/lessons/<lesson>/` as REAL .ts files: the compiler (`npm run check`)
 * and the linter check them like the rest of the code, and the browser tests run them. Here they
 * are read as text and handed to the editor. `main.ts` is the one that starts, and goes first.
 *
 * (The labels are the site's text, in Spanish.)
 */
interface Props {
  lesson: string;
  /** Start by itself when it shows up on screen (each lesson's first example). */
  autorun?: boolean;
}

const { lesson, autorun = false } = Astro.props;
const all = import.meta.glob<string>('../lessons/**/*.ts', { query: '?raw', import: 'default', eager: true });
const prefix = `../lessons/${lesson}/`;
const files = Object.entries(all)
  .filter(([path]) => path.startsWith(prefix))
  .map(([path, code]) => ({ name: path.slice(prefix.length), code }))
  .sort((a, b) => (a.name === 'main.ts' ? -1 : b.name === 'main.ts' ? 1 : a.name.localeCompare(b.name)));
if (!files.some((f) => f.name === 'main.ts')) {
  throw new Error(`The lesson "${lesson}" has no main.ts (in src/lessons/${lesson}/)`);
}
---

<div
  class="live-code not-content"
  data-files={JSON.stringify(files)}
  data-base={import.meta.env.BASE_URL}
  data-autorun={autorun ? '1' : undefined}
  data-state="stopped"
>
  <!-- First what is seen (the reader finds it without scrolling), then the code. -->
  <div class="lc-result">
    <button type="button" class="lc-cover">▶ Ejecutar</button>
  </div>
  <div class="lc-console" hidden></div>
  <div class="lc-bar">
    <div class="lc-tabs" role="tablist" aria-label="Archivos de la lección"></div>
    <div class="lc-actions">
      <button type="button" class="lc-expand" title="El código y lo que dibuja, en pantalla completa" aria-pressed="false">
        <span aria-hidden="true">⛶</span><span class="lc-label"> Pantalla completa</span>
      </button>
      <button type="button" class="lc-reset" title="Volver al código original">↺ Restaurar</button>
      <button type="button" class="lc-run" title="Ejecutar (Ctrl o ⌘ + Enter)">▶ Ejecutar</button>
    </div>
  </div>
  <div class="lc-editor"></div>
  <!-- Side by side only: the line between the code and the result, which can be dragged. -->
  <div
    class="lc-divider"
    role="separator"
    aria-orientation="vertical"
    aria-label="Ancho del código"
    aria-valuemin="20"
    aria-valuemax="80"
    aria-valuenow="42"
    tabindex="0"
  >
  </div>
</div>

<style is:global>
  /* The frame: bronze with patina (like the cards). Inside, always dark, also in light mode. */
  .live-code {
    margin-block: 1.5rem;
    border: 2px solid transparent;
    border-radius: 0.6rem;
    overflow: hidden;
    background:
      linear-gradient(#1a1714, #1a1714) padding-box,
      var(--mg-patina) border-box,
      var(--mg-rust) border-box,
      var(--mg-bronze) border-box;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.5),
      var(--mg-shadow);
  }
  .live-code .lc-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    background: linear-gradient(180deg, #25201b, #1d1915);
    border-top: 1px solid #0b0907;
    border-bottom: 1px solid #2c2620;
    flex-wrap: wrap;
  }
  .live-code .lc-tabs {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .live-code button {
    font: 13px/1.2 var(--sl-font-system-mono, ui-monospace, monospace);
    color: #b8ab97;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }
  .live-code button:hover {
    color: #f3e9d8;
  }
  .live-code .lc-tabs button[aria-selected='true'] {
    color: #f0d59a;
    border-color: rgb(201 144 80 / 0.45);
    background: #1a1714;
  }
  .live-code .lc-actions {
    display: flex;
    gap: 0.35rem;
  }
  /* Run: a plate of old metal, like the site's main button. */
  .live-code .lc-run,
  .live-code .lc-run:hover {
    color: #ead5b0;
    background: var(--mg-metal-soft);
    border-color: #24170a;
    box-shadow: var(--mg-bevel);
    text-shadow: 0 -1px 0 rgb(0 0 0 / 0.65);
    font-weight: 700;
  }
  .live-code .lc-run:hover {
    filter: brightness(1.08);
  }
  .live-code .lc-editor .cm-editor {
    max-height: 26rem;
    font-size: 13px;
  }
  .live-code .lc-editor .cm-scroller {
    overflow: auto;
  }
  .live-code .lc-result {
    position: relative;
    aspect-ratio: 16 / 9;
    background: radial-gradient(ellipse 70% 70% at 50% 55%, #1b1813, #15120f 60%, #0e0c0a);
  }
  .live-code .lc-result iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .live-code .lc-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    font: 600 1.15rem/1 var(--mg-font-title, serif);
    letter-spacing: 0.08em;
    color: #cfa66c;
  }
  .live-code .lc-cover:hover {
    color: #e2c08a;
  }
  .live-code .lc-cover[hidden] {
    display: none;
  }
  .live-code .lc-console {
    max-height: 9rem;
    overflow: auto;
    padding: 0.4rem 0.75rem;
    font: 12px/1.45 var(--sl-font-system-mono, ui-monospace, monospace);
    color: #c9bca7;
    background: #13110e;
    border-top: 1px solid #2c2620;
    white-space: pre-wrap;
  }
  .live-code .lc-console[hidden] {
    display: none;
  }
  .live-code .lc-warn {
    color: #e5c07b;
  }
  .live-code .lc-error {
    color: #e88a7d;
  }
  .live-code .lc-divider {
    display: none;
  }

  /*
   * THE WHOLE WIDTH (src/live-code/width.ts). The example breaks out of the text's column and takes
   * the central panel's width: `--lc-width` is that width and `--lc-offset`, how far to move left to
   * start at its edge.
   */
  .live-code[data-wide]:not([data-expanded]) {
    width: var(--lc-width);
    max-width: none;
    margin-inline-start: var(--lc-offset);
  }

  /*
   * SIDE BY SIDE: the code on the left, what it draws on the right, and the console below. Used by
   * full screen (data-expanded) and by the example in the page when there is width to spare
   * (data-side-by-side). Nothing moves in the page (if the iframe changed parent, it would reload
   * and the example would start over): only the layout changes, with a grid.
   */
  .live-code:is([data-expanded], [data-side-by-side]) {
    display: grid;
    grid-template-columns: minmax(16rem, var(--lc-code, 42%)) 6px minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'bar divider result'
      'editor divider result'
      'editor divider console';
  }
  .live-code[data-side-by-side]:not([data-expanded]) {
    height: clamp(28rem, 76vh, 46rem);
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-bar {
    grid-area: bar;
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-editor {
    grid-area: editor;
    min-height: 0;
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-editor .cm-editor {
    height: 100%;
    max-height: none;
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-result {
    grid-area: result;
    aspect-ratio: auto;
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-console {
    grid-area: console;
    max-height: 30vh;
  }
  .live-code:is([data-expanded], [data-side-by-side]) .lc-divider {
    grid-area: divider;
    display: block;
    cursor: col-resize;
    touch-action: none;
    background: var(--mg-bronze, #6d4f2e);
    box-shadow:
      inset 1px 0 0 rgb(255 240 210 / 0.15),
      inset -1px 0 0 rgb(0 0 0 / 0.5);
  }
  .live-code .lc-divider:focus-visible {
    outline: 2px solid #93d9c9;
    outline-offset: -2px;
  }
  /* While dragging, the iframe does not keep the pointer's movements. */
  .live-code[data-dragging] iframe {
    pointer-events: none;
  }

  /*
   * FULL SCREEN: the same, taking the whole screen. It works the same for the browser's full screen
   * (data-expanded="screen") and for when there is none, like on the iPhone ("window"). On a narrow
   * or vertical screen, one above the other.
   */
  .live-code[data-expanded] {
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #1a1714;
  }
  .live-code[data-expanded='window'] {
    position: fixed;
    inset: 0;
    z-index: 1000;
    height: 100dvh;
  }
  :root.lc-has-expanded {
    overflow: hidden; /* the page behind does not scroll */
  }
  .live-code:fullscreen::backdrop {
    background: #000;
  }
  @media (max-width: 50rem), (max-aspect-ratio: 1/1) {
    .live-code[data-expanded] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 1fr);
      grid-template-areas: 'result' 'console' 'bar' 'editor';
    }
    .live-code[data-expanded] .lc-divider {
      display: none;
    }
  }
  /* In a narrow bar, the button keeps only its symbol. */
  @media (max-width: 30rem) {
    .live-code .lc-expand .lc-label {
      display: none;
    }
  }
</style>

<script>
  import { widenExamples } from '../live-code/width';
  import { mountLiveCode } from '../live-code/mount';
  const examples = [...document.querySelectorAll<HTMLElement>('.live-code')];
  examples.forEach(mountLiveCode);
  widenExamples(examples);
</script>
