---
/**
 * Starlight's theme selector (it replaces "ThemeSelect" in astro.config.mjs), with two buttons
 * beside it to hide or show the SIDE PANELS: the site's index, on the left, and "En esta página"
 * (on this page), on the right. Without them, the lesson and its examples use that width.
 *
 * They go here because the header is the only thing always visible, also with both panels hidden.
 * The choice is remembered in the browser (localStorage) and applied BEFORE the page is drawn, with
 * a script in the <head> (astro.config.mjs), so it does not flicker when changing pages.
 *
 * This component also shows up in the phone menu: there the buttons are not shown, because on a
 * narrow screen the panels no longer take room at the side.
 *
 * This component's code handles every button with `data-panel`: the header's, the "Ocultar" (hide)
 * ones at the top of each panel (Sidebar.astro and PageSidebar.astro) and the edge tabs that show
 * them again.
 *
 * (The labels are the site's text, in Spanish.)
 */
import Default from '@astrojs/starlight/components/ThemeSelect.astro';
---

<div class="mg-panels">
  <button type="button" class="mg-panel" data-panel="sidebar" aria-pressed="true" aria-label="Índice del sitio">
    <svg viewBox="0 0 20 16" aria-hidden="true">
      <rect class="mg-side" x="2" y="2" width="5" height="12" />
      <rect x="1" y="1" width="18" height="14" rx="2" />
      <path d="M7 1v14" />
    </svg>
  </button>
  <button type="button" class="mg-panel" data-panel="toc" aria-pressed="true" aria-label="En esta página">
    <svg viewBox="0 0 20 16" aria-hidden="true">
      <rect class="mg-side" x="13" y="2" width="5" height="12" />
      <rect x="1" y="1" width="18" height="14" rx="2" />
      <path d="M13 1v14" />
    </svg>
  </button>
</div>
<!--
  When a panel is hidden, a tab at the edge of the screen shows it again: there is always a way back,
  even if the header is not fully visible (with a lot of zoom, for example).
-->
<!-- (Without the "mg-panel" class: its style here would always show them. workshop.css hides and shows them.) -->
<button type="button" class="mg-show mg-show-sidebar" data-panel="sidebar">› Índice</button>
<button type="button" class="mg-show mg-show-toc" data-panel="toc">En esta página ‹</button>
<Default />

<style>
  .mg-panels {
    display: none;
    gap: 0.15rem;
    align-items: center;
  }
  @media (min-width: 50rem) {
    :global(:root[data-has-sidebar]) .mg-panels {
      display: flex;
    }
  }
  .mg-panel {
    display: inline-flex;
    padding: 0.3rem;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .mg-panel:hover {
    color: var(--sl-color-white);
    border-color: var(--mg-bronze-line);
  }
  .mg-panel svg {
    width: 1.25rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
  /* The filled side = the panel is in view. */
  .mg-side {
    stroke: none;
    fill: transparent;
  }
  .mg-panel[aria-pressed='true'] .mg-side {
    fill: color-mix(in srgb, currentColor 55%, transparent);
  }
  /* "En esta página" only exists at the side from 72rem on, and only if the page has sections. */
  .mg-panel[data-panel='toc'] {
    display: none;
  }
  @media (min-width: 72rem) {
    :global(:root[data-has-toc]) .mg-panel[data-panel='toc'] {
      display: inline-flex;
    }
  }
</style>

<script>
  /** Each panel: where it is remembered and which <html> attribute hides it (the CSS is in workshop.css). */
  const PANELS = {
    sidebar: { key: 'mg-no-sidebar', attribute: 'data-no-sidebar', name: 'el índice del sitio' },
    toc: { key: 'mg-no-toc', attribute: 'data-no-toc', name: '«En esta página»' },
  } as const;
  type Panel = keyof typeof PANELS;
  const root = document.documentElement;

  function paint() {
    for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-panel]')) {
      const panel = PANELS[button.dataset.panel as Panel];
      const hidden = root.hasAttribute(panel.attribute);
      button.title = `${hidden ? 'Mostrar' : 'Ocultar'} ${panel.name}`;
      // The header's turn on and off. The ones at the top of each panel ("mg-hide") only hide, and
      // the edge tabs ("mg-show") only show.
      const oneWay = button.classList.contains('mg-hide') || button.classList.contains('mg-show');
      if (!oneWay) button.setAttribute('aria-pressed', String(!hidden));
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-panel]')) {
    button.addEventListener('click', () => {
      const panel = PANELS[button.dataset.panel as Panel];
      const hide = !root.hasAttribute(panel.attribute);
      root.toggleAttribute(panel.attribute, hide);
      try {
        if (hide) localStorage.setItem(panel.key, '1');
        else localStorage.removeItem(panel.key);
      } catch {
        // No storage (a private window, for example): it only lasts for this page.
      }
      paint();
    });
  }
  paint();
</script>
