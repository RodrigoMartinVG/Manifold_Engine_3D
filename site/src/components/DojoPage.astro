---
/**
 * THE DOJO'S PAGE: full screen, without the site's frame. The game is mounted in #game. Two pages
 * use it: `/jugar/dojo/` and each saved room's (`/jugar/dojo/rain/`), which passes its name
 * (decision 0010: every room has its address). Astro bundles the <script> with Vite, like any page:
 * it imports the Dojo as one more package of the monorepo.
 */
import '@fontsource-variable/cinzel';
import rust from '../assets/drawings/rust.svg';

interface Props {
  /** The saved room (its recipe's name), if one came in through its address. */
  room?: string;
  /** Its title, for the browser tab. */
  title?: string;
}
const { room, title } = Astro.props;
const home = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Dojo · Manifold Gaming` : 'Dojo · Manifold Gaming'}</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #14161c;
        color: #e8e8ea;
        font: 14px/1.4 system-ui, sans-serif;
      }
      #game {
        position: fixed;
        inset: 0;
      }
      /* Back: a small plate of old metal, like the site's buttons. Bottom right: the console opens
         at the top, and its button is at the bottom left. */
      #back {
        position: fixed;
        right: 12px;
        bottom: 12px;
        padding: 0.35rem 0.9rem;
        border: 1px solid #24170a;
        border-radius: 0.35rem;
        /* The same metal as the site (workshop.css): old bronze with the rust texture on top. */
        background:
          var(--rust) 0 0 / 220px 220px,
          linear-gradient(160deg, #3c2916 0%, #4c351f 35%, #553c24 55%, #48321c 80%, #3f2b17 100%);
        box-shadow:
          inset 0 1px 0 rgb(255 225 180 / 0.1),
          0 6px 14px -6px rgb(0 0 0 / 0.8);
        color: #ead5b0;
        text-shadow: 0 -1px 0 rgb(0 0 0 / 0.65);
        font: 700 13px/1.4 'Cinzel Variable', Georgia, serif;
        letter-spacing: 0.06em;
        text-decoration: none;
        opacity: 0.85;
      }
      #back:hover {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <div id="game" data-room={room}></div>
    <a id="back" href={home} style={`--rust: url(${rust.src})`}>← Manifold Gaming</a>
    <script>
      import { startDojo } from '@manifold/dojo';
      const game = document.getElementById('game')!;
      startDojo(game, { room: game.dataset.room, base: import.meta.env.BASE_URL });
    </script>
  </body>
</html>
