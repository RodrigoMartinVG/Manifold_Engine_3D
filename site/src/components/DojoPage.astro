---
/**
 * LA PÁGINA DEL DOJO: pantalla completa, sin el marco del sitio. El juego se monta en #juego.
 * La usan dos páginas: `/jugar/dojo/` y la de cada sala guardada (`/jugar/dojo/lluvia/`), que
 * le pasa su nombre (decisión 0010: cada sala tiene su dirección). Astro empaqueta el <script>
 * con Vite, como cualquier página: importa el Dojo como un paquete más del monorepo.
 */
import '@fontsource-variable/cinzel';
import oxido from '../assets/dibujos/oxido.svg';

interface Props {
  /** La sala guardada (el nombre de su receta), si se entró por la dirección de una. */
  sala?: string;
  /** Su título, para la pestaña del navegador. */
  titulo?: string;
}
const { sala, titulo } = Astro.props;
const inicio = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo ? `${titulo} · Dojo · Manifold Gaming` : 'Dojo · Manifold Gaming'}</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #14161c;
        color: #e8e8ea;
        font: 14px/1.4 system-ui, sans-serif;
      }
      #juego {
        position: fixed;
        inset: 0;
      }
      /* Volver: una plaquita de metal viejo, como los botones del sitio. Abajo a la derecha: arriba
         se abre la consola, y abajo a la izquierda está su botón. */
      #volver {
        position: fixed;
        right: 12px;
        bottom: 12px;
        padding: 0.35rem 0.9rem;
        border: 1px solid #24170a;
        border-radius: 0.35rem;
        /* El mismo metal que el sitio (taller.css): bronce viejo y la textura de óxido encima. */
        background:
          var(--oxido) 0 0 / 220px 220px,
          linear-gradient(160deg, #3c2916 0%, #4c351f 35%, #553c24 55%, #48321c 80%, #3f2b17 100%);
        box-shadow:
          inset 0 1px 0 rgb(255 225 180 / 0.1),
          0 6px 14px -6px rgb(0 0 0 / 0.8);
        color: #ead5b0;
        text-shadow: 0 -1px 0 rgb(0 0 0 / 0.65);
        font: 700 13px/1.4 'Cinzel Variable', Georgia, serif;
        letter-spacing: 0.06em;
        text-decoration: none;
        opacity: 0.85;
      }
      #volver:hover {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <div id="juego" data-sala={sala}></div>
    <a id="volver" href={inicio} style={`--oxido: url(${oxido.src})`}>← Manifold Gaming</a>
    <script>
      import { arrancarDojo } from '@manifold/dojo';
      const juego = document.getElementById('juego')!;
      arrancarDojo(juego, { sala: juego.dataset.sala, base: import.meta.env.BASE_URL });
    </script>
  </body>
</html>
