---
/**
 * THE HOME PAGE'S HERO: it replaces Starlight's "Hero" (astro.config.mjs → components). It takes the
 * same from the page's frontmatter (`hero.title`, `hero.tagline`, `hero.actions`), and instead of an
 * image it shows the live 3D showcase.
 *
 * The <h1> keeps the id `_top` and `data-page-title`, like Starlight's: that is how the "back to
 * top" link and screen readers find it.
 *
 * (The texts are the site's, in Spanish.)
 */
import { LinkButton } from '@astrojs/starlight/components';
import Showcase from './Showcase.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
// "Manifold Gaming": the first word big; the rest below, spaced out.
const [first, ...rest] = title.split(' ');
---

<div class="hero">
  <div class="hero-text">
    <p class="hero-kicker">Laboratorio de mundos físicos en 3D</p>
    <h1 id="_top" data-page-title>
      <span class="hero-title-1">{first}</span>
      {rest.length > 0 && <span class="hero-title-2">{rest.join(' ')}</span>}
    </h1>
    <svg class="hero-ornament" viewBox="0 0 260 18" aria-hidden="true">
      <path d="M0 9H104M156 9H260M112 9h-4M152 9h-4M120 9h-3M143 9h-3" />
      <circle cx="130" cy="9" r="7" />
      <circle cx="130" cy="9" r="2.2" />
      <path d="M130 0v4M130 14v4" />
    </svg>
    {tagline && <div class="hero-tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="hero-actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }, i) => (
            <>
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
              {i === 0 && <span class="hero-break" />}
            </>
          ))}
        </div>
      )
    }
  </div>
  <Showcase />
</div>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 3rem;
  }
  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 3.5rem;
      padding-block: 3.5rem 4.5rem;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 62rem) {
    .hero-text {
      align-items: flex-start;
      text-align: start;
    }
  }

  .hero-kicker {
    margin: 0;
    font-family: var(--mg-font-title);
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.8rem);
    font-weight: 600;
    letter-spacing: clamp(0.1em, 0.03em + 0.6vw, 0.22em);
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }

  /* The title: embossed bronze letters (the gradient is clipped to the letter; the shadow lifts it). */
  h1 {
    /* The first word's size; the second is a fixed fraction, so the proportion does not change. */
    --t: clamp(2.7rem, 1.4rem + 5vw, 4.6rem);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: inherit;
    font-family: var(--mg-font-title);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    filter: drop-shadow(0 2px 0 rgb(30 18 8 / 0.9)) drop-shadow(0 10px 18px rgb(0 0 0 / 0.55));
  }
  :global([data-theme='light']) h1 {
    filter: drop-shadow(0 1px 0 rgb(255 250 240 / 0.9)) drop-shadow(0 6px 12px rgb(80 50 20 / 0.25));
  }
  /* The letters: old metal, with rust stains in the stroke. */
  h1 span {
    background: var(--mg-rust), var(--mg-metal-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-title-1 {
    font-size: var(--t);
    letter-spacing: 0.03em;
  }
  .hero-title-2 {
    margin-top: 0.3em;
    font-size: calc(var(--t) * 0.42);
    /* Spaced so that "GAMING" takes the width of "MANIFOLD" (measured in the browser). The last
       letter does not need its space: the negative margin makes up for it. */
    letter-spacing: 1.85em;
    margin-inline-end: -1.85em;
  }

  .hero-ornament {
    width: 15rem;
    height: auto;
    fill: none;
    stroke: var(--mg-bronze-line-strong);
    stroke-width: 1.2;
  }

  .hero-tagline {
    max-width: 36rem;
    font-family: var(--mg-font-book);
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.17rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  /* The main action alone on its line; the other two, below and together. */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
    justify-content: center;
    margin-top: 0.4rem;
  }
  .hero-break {
    flex-basis: 100%;
    height: 0;
  }
  @media (min-width: 62rem) {
    .hero-actions {
      justify-content: flex-start;
    }
  }
  /* The secondary buttons: patina plates, quieter than the bronze one. */
  .hero-actions :global(.sl-link-button.minimal) {
    padding: 0.9rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 45%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--sl-color-accent-high);
    font-family: var(--mg-font-title);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .hero-actions :global(.sl-link-button.minimal:hover) {
    background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    color: var(--sl-color-white);
  }
</style>
