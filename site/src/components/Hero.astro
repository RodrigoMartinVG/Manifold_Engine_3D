---
/**
 * LA PORTADA del inicio: reemplaza al "Hero" de Starlight (astro.config.mjs → components). Toma
 * lo mismo del frontmatter de la página (`hero.title`, `hero.tagline`, `hero.actions`), y en vez
 * de una imagen muestra la vitrina 3D en vivo.
 *
 * El <h1> conserva el id `_top` y `data-page-title`, como el de Starlight: así lo encuentran el
 * enlace "volver arriba" y los lectores de pantalla.
 */
import { LinkButton } from '@astrojs/starlight/components';
import Vitrina from './Vitrina.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
// "Manifold Gaming": la primera palabra grande; el resto debajo, espaciado.
const [primera, ...resto] = title.split(' ');
---

<div class="heroe">
  <div class="heroe-texto">
    <p class="heroe-antetitulo">Laboratorio de mundos físicos en 3D</p>
    <h1 id="_top" data-page-title>
      <span class="heroe-titulo-1">{primera}</span>
      {resto.length > 0 && <span class="heroe-titulo-2">{resto.join(' ')}</span>}
    </h1>
    <svg class="heroe-ornamento" viewBox="0 0 260 18" aria-hidden="true">
      <path d="M0 9H104M156 9H260M112 9h-4M152 9h-4M120 9h-3M143 9h-3" />
      <circle cx="130" cy="9" r="7" />
      <circle cx="130" cy="9" r="2.2" />
      <path d="M130 0v4M130 14v4" />
    </svg>
    {tagline && <div class="heroe-lema" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="heroe-acciones">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }, i) => (
            <>
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
              {i === 0 && <span class="heroe-salto" />}
            </>
          ))}
        </div>
      )
    }
  </div>
  <Vitrina />
</div>

<style>
  .heroe {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 1.5rem 3rem;
  }
  @media (min-width: 62rem) {
    .heroe {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 3.5rem;
      padding-block: 3.5rem 4.5rem;
    }
  }

  .heroe-texto {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 62rem) {
    .heroe-texto {
      align-items: flex-start;
      text-align: start;
    }
  }

  .heroe-antetitulo {
    margin: 0;
    font-family: var(--mg-letra-titulo);
    font-size: clamp(0.68rem, 0.6rem + 0.3vw, 0.8rem);
    font-weight: 600;
    letter-spacing: clamp(0.1em, 0.03em + 0.6vw, 0.22em);
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
  }

  /* El título: letras de bronce en relieve (el degradado recorta la letra; la sombra la levanta). */
  h1 {
    /* El tamaño de la primera palabra; la segunda es una fracción fija, así la proporción no cambia. */
    --t: clamp(2.7rem, 1.4rem + 5vw, 4.6rem);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: inherit;
    font-family: var(--mg-letra-titulo);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    filter: drop-shadow(0 2px 0 rgb(30 18 8 / 0.9)) drop-shadow(0 10px 18px rgb(0 0 0 / 0.55));
  }
  :global([data-theme='light']) h1 {
    filter: drop-shadow(0 1px 0 rgb(255 250 240 / 0.9)) drop-shadow(0 6px 12px rgb(80 50 20 / 0.25));
  }
  /* Las letras: metal viejo, con manchas de óxido en el trazo. */
  h1 span {
    background: var(--mg-oxido), var(--mg-texto-metal);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .heroe-titulo-1 {
    font-size: var(--t);
    letter-spacing: 0.03em;
  }
  .heroe-titulo-2 {
    margin-top: 0.3em;
    font-size: calc(var(--t) * 0.42);
    /* Espaciado para que "GAMING" ocupe el ancho de "MANIFOLD" (medido en el navegador). La
       última letra no necesita su espacio: se compensa con el margen negativo. */
    letter-spacing: 1.85em;
    margin-inline-end: -1.85em;
  }

  .heroe-ornamento {
    width: 15rem;
    height: auto;
    fill: none;
    stroke: var(--mg-linea-bronce-fuerte);
    stroke-width: 1.2;
  }

  .heroe-lema {
    max-width: 36rem;
    font-family: var(--mg-letra-libro);
    font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.17rem);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  /* La acción principal sola en su renglón; las otras dos, debajo y juntas. */
  .heroe-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1rem;
    justify-content: center;
    margin-top: 0.4rem;
  }
  .heroe-salto {
    flex-basis: 100%;
    height: 0;
  }
  @media (min-width: 62rem) {
    .heroe-acciones {
      justify-content: flex-start;
    }
  }
  /* Los botones secundarios: placas de pátina, más quietas que la de bronce. */
  .heroe-acciones :global(.sl-link-button.minimal) {
    padding: 0.9rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent-high) 45%, transparent);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--sl-color-accent-high);
    font-family: var(--mg-letra-titulo);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .heroe-acciones :global(.sl-link-button.minimal:hover) {
    background: color-mix(in srgb, var(--sl-color-accent) 20%, transparent);
    color: var(--sl-color-white);
  }
</style>
