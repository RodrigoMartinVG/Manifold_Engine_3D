---
/**
 * Starlight's "En esta página" (on this page) panel (it replaces "PageSidebar" in astro.config.mjs),
 * with a button at the top to hide it. It does the same as the header's button (ThemeSelect.astro,
 * which has the code). It only shows up when the panel is at the side, from 72rem on.
 */
import Default from '@astrojs/starlight/components/PageSidebar.astro';
---

{
  Astro.locals.starlightRoute.toc && (
    <button type="button" class="mg-panel mg-hide mg-hide-toc" data-panel="toc">
      Ocultar ›
    </button>
  )
}
<Default />
