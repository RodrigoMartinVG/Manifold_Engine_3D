---
/**
 * La página del Dojo: pantalla completa, sin el marco del sitio. El juego se monta en #juego.
 * (Astro empaqueta el <script> con Vite, como cualquier página: importa el Dojo como un
 * paquete más del monorepo.)
 */
import '@fontsource-variable/cinzel';
const inicio = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dojo · Manifold Gaming</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #14161c;
        color: #e8e8ea;
        font: 14px/1.4 system-ui, sans-serif;
      }
      #juego {
        position: fixed;
        inset: 0;
      }
      /* Volver: una plaquita de bronce, como los botones del sitio. */
      #volver {
        position: fixed;
        top: 12px;
        left: 12px;
        padding: 0.35rem 0.9rem;
        border: 1px solid #3a2410;
        border-radius: 0.35rem;
        background: linear-gradient(160deg, #6b4421, #b98146 22%, #f1d29b 38%, #c08648 52%, #7f5229 72%, #cf9d5c);
        box-shadow:
          inset 0 1px 0 rgb(255 240 210 / 0.55),
          0 6px 14px -6px rgb(0 0 0 / 0.8);
        color: #1d1209;
        text-shadow: 0 1px 0 rgb(255 232 196 / 0.45);
        font: 700 13px/1.4 'Cinzel Variable', Georgia, serif;
        letter-spacing: 0.06em;
        text-decoration: none;
        opacity: 0.85;
      }
      #volver:hover {
        opacity: 1;
      }
    </style>
  </head>
  <body>
    <div id="juego"></div>
    <a id="volver" href={inicio}>← Manifold Gaming</a>
    <script>
      import { arrancarDojo } from '@manifold/dojo';
      arrancarDojo(document.getElementById('juego')!);
    </script>
  </body>
</html>
