---
/**
 * <CodigoVivo leccion="etapa-0/01-primer-cubo" />: un ejemplo que se edita y se ejecuta en la
 * página (decisión 0007).
 *
 * Los archivos de la lección viven en `src/lecciones/<leccion>/` como archivos .ts DE VERDAD:
 * el compilador (`npm run check`) y el linter los revisan como al resto del código, y las
 * pruebas en el navegador los ejecutan. Aquí se leen como texto y se le pasan al editor.
 * `main.ts` es el que arranca, y va primero.
 */
interface Props {
  leccion: string;
  /** Arrancar solo cuando aparece en pantalla (el primer ejemplo de cada lección). */
  autoejecutar?: boolean;
}

const { leccion, autoejecutar = false } = Astro.props;
const todos = import.meta.glob<string>('../lecciones/**/*.ts', { query: '?raw', import: 'default', eager: true });
const prefijo = `../lecciones/${leccion}/`;
const archivos = Object.entries(todos)
  .filter(([ruta]) => ruta.startsWith(prefijo))
  .map(([ruta, codigo]) => ({ nombre: ruta.slice(prefijo.length), codigo }))
  .sort((a, b) => (a.nombre === 'main.ts' ? -1 : b.nombre === 'main.ts' ? 1 : a.nombre.localeCompare(b.nombre)));
if (!archivos.some((a) => a.nombre === 'main.ts')) {
  throw new Error(`La lección "${leccion}" no tiene main.ts (en src/lecciones/${leccion}/)`);
}
---

<div
  class="codigo-vivo not-content"
  data-archivos={JSON.stringify(archivos)}
  data-base={import.meta.env.BASE_URL}
  data-autoejecutar={autoejecutar ? '1' : undefined}
  data-estado="detenido"
>
  <!-- Primero lo que se ve (el lector lo encuentra sin bajar), después el código. -->
  <div class="cv-resultado">
    <button type="button" class="cv-portada">▶ Ejecutar</button>
  </div>
  <div class="cv-consola" hidden></div>
  <div class="cv-barra">
    <div class="cv-pestanas" role="tablist" aria-label="Archivos de la lección"></div>
    <div class="cv-acciones">
      <button type="button" class="cv-ampliar" title="El código y lo que dibuja, en pantalla completa" aria-pressed="false">
        <span aria-hidden="true">⛶</span><span class="cv-texto"> Pantalla completa</span>
      </button>
      <button type="button" class="cv-restaurar" title="Volver al código original">↺ Restaurar</button>
      <button type="button" class="cv-ejecutar" title="Ejecutar (Ctrl o ⌘ + Enter)">▶ Ejecutar</button>
    </div>
  </div>
  <div class="cv-editor"></div>
  <!-- Solo en pantalla completa: la línea entre el código y el resultado, que se puede arrastrar. -->
  <div
    class="cv-divisor"
    role="separator"
    aria-orientation="vertical"
    aria-label="Ancho del código"
    aria-valuemin="20"
    aria-valuemax="80"
    aria-valuenow="42"
    tabindex="0"
  >
  </div>
</div>

<style is:global>
  /* El marco: bronce con pátina (como las tarjetas). Adentro, siempre oscuro, también en el modo claro. */
  .codigo-vivo {
    margin-block: 1.5rem;
    border: 2px solid transparent;
    border-radius: 0.6rem;
    overflow: hidden;
    background:
      linear-gradient(#1a1714, #1a1714) padding-box,
      var(--mg-patina) border-box,
      var(--mg-bronce) border-box;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.5),
      var(--mg-sombra);
  }
  .codigo-vivo .cv-barra {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.5rem;
    background: linear-gradient(180deg, #25201b, #1d1915);
    border-top: 1px solid #0b0907;
    border-bottom: 1px solid #2c2620;
    flex-wrap: wrap;
  }
  .codigo-vivo .cv-pestanas {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .codigo-vivo button {
    font: 13px/1.2 var(--sl-font-system-mono, ui-monospace, monospace);
    color: #b8ab97;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }
  .codigo-vivo button:hover {
    color: #f3e9d8;
  }
  .codigo-vivo .cv-pestanas button[aria-selected='true'] {
    color: #f0d59a;
    border-color: rgb(201 144 80 / 0.45);
    background: #1a1714;
  }
  .codigo-vivo .cv-acciones {
    display: flex;
    gap: 0.35rem;
  }
  /* Ejecutar: una placa de bronce, como el botón principal del sitio. */
  .codigo-vivo .cv-ejecutar,
  .codigo-vivo .cv-ejecutar:hover {
    color: #1d1209;
    background: var(--mg-bronce);
    border-color: #3a2410;
    box-shadow:
      inset 0 1px 0 rgb(255 240 210 / 0.55),
      inset 0 -1px 0 rgb(0 0 0 / 0.3);
    text-shadow: 0 1px 0 rgb(255 232 196 / 0.45);
    font-weight: 700;
  }
  .codigo-vivo .cv-ejecutar:hover {
    filter: brightness(1.08);
  }
  .codigo-vivo .cv-editor .cm-editor {
    max-height: 26rem;
    font-size: 13px;
  }
  .codigo-vivo .cv-editor .cm-scroller {
    overflow: auto;
  }
  .codigo-vivo .cv-resultado {
    position: relative;
    aspect-ratio: 16 / 9;
    background: radial-gradient(ellipse 70% 70% at 50% 55%, #1b1813, #15120f 60%, #0e0c0a);
  }
  .codigo-vivo .cv-resultado iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .codigo-vivo .cv-portada {
    position: absolute;
    inset: 0;
    width: 100%;
    font: 600 1.15rem/1 var(--mg-letra-titulo, serif);
    letter-spacing: 0.08em;
    color: #e9c48c;
  }
  .codigo-vivo .cv-portada:hover {
    color: #fbe6bd;
  }
  .codigo-vivo .cv-portada[hidden] {
    display: none;
  }
  .codigo-vivo .cv-consola {
    max-height: 9rem;
    overflow: auto;
    padding: 0.4rem 0.75rem;
    font: 12px/1.45 var(--sl-font-system-mono, ui-monospace, monospace);
    color: #c9bca7;
    background: #13110e;
    border-top: 1px solid #2c2620;
    white-space: pre-wrap;
  }
  .codigo-vivo .cv-consola[hidden] {
    display: none;
  }
  .codigo-vivo .cv-warn {
    color: #e5c07b;
  }
  .codigo-vivo .cv-error {
    color: #e88a7d;
  }
  .codigo-vivo .cv-divisor {
    display: none;
  }

  /*
   * PANTALLA COMPLETA. Nada se mueve de lugar en la página (si el iframe cambiara de padre, se
   * recargaría y el ejemplo empezaría de nuevo): solo cambia la disposición, con una grilla. El
   * código a la izquierda, lo que dibuja a la derecha, y la consola debajo; en una pantalla
   * angosta, uno arriba del otro. Sirve igual para la pantalla completa del navegador
   * (data-ampliado="pantalla") y para cuando no la hay, como en el iPhone ("ventana").
   */
  .codigo-vivo[data-ampliado] {
    --cv-codigo: 42%;
    display: grid;
    grid-template-columns: minmax(14rem, var(--cv-codigo)) 6px minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'barra divisor resultado'
      'editor divisor resultado'
      'editor divisor consola';
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    background: #1a1714;
  }
  .codigo-vivo[data-ampliado='ventana'] {
    position: fixed;
    inset: 0;
    z-index: 1000;
    height: 100dvh;
  }
  :root.cv-con-ampliado {
    overflow: hidden; /* la página de atrás no se desplaza */
  }
  .codigo-vivo:fullscreen::backdrop {
    background: #000;
  }
  .codigo-vivo[data-ampliado] .cv-barra {
    grid-area: barra;
  }
  .codigo-vivo[data-ampliado] .cv-editor {
    grid-area: editor;
    min-height: 0;
  }
  .codigo-vivo[data-ampliado] .cv-editor .cm-editor {
    height: 100%;
    max-height: none;
  }
  .codigo-vivo[data-ampliado] .cv-resultado {
    grid-area: resultado;
    aspect-ratio: auto;
  }
  .codigo-vivo[data-ampliado] .cv-consola {
    grid-area: consola;
    max-height: 30vh;
  }
  .codigo-vivo[data-ampliado] .cv-divisor {
    grid-area: divisor;
    display: block;
    cursor: col-resize;
    touch-action: none;
    background: var(--mg-bronce, #b98146);
    box-shadow:
      inset 1px 0 0 rgb(255 240 210 / 0.35),
      inset -1px 0 0 rgb(0 0 0 / 0.5);
  }
  .codigo-vivo[data-ampliado] .cv-divisor:focus-visible {
    outline: 2px solid #93d9c9;
    outline-offset: -2px;
  }
  /* Mientras se arrastra, el iframe no se queda con los movimientos del puntero. */
  .codigo-vivo[data-arrastrando] iframe {
    pointer-events: none;
  }
  @media (max-width: 50rem), (max-aspect-ratio: 1/1) {
    .codigo-vivo[data-ampliado] {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 1fr);
      grid-template-areas: 'resultado' 'consola' 'barra' 'editor';
    }
    .codigo-vivo[data-ampliado] .cv-divisor {
      display: none;
    }
  }
  /* En una barra angosta, el botón queda solo con su símbolo. */
  @media (max-width: 30rem) {
    .codigo-vivo .cv-ampliar .cv-texto {
      display: none;
    }
  }
</style>

<script>
  import { montarCodigoVivo } from '../codigo-vivo/montar';
  document.querySelectorAll<HTMLElement>('.codigo-vivo').forEach(montarCodigoVivo);
</script>
